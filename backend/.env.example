# Copy to .env (gitignored) and fill in. Never commit the real values.

# SQLAlchemy URL for the costs database (Postgres). Only needed if it isn't the local
# dev one from `docker compose up -d` (e.g. pointing at the NAS instead) - the default
# in app/config.py already matches docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://homie:homie@localhost:5432/homie

# Client id/secret of your SmartThings OAuth-In app (for Samsung AC/TV/speaker control).
# See CLAUDE.md's "Tuya devices" bullet for the one-time setup via the SmartThings CLI.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=

# Application (client) ID of your Microsoft Entra app registration (for Microsoft To Do).
MS_CLIENT_ID=

# Names of the To Do lists to show on the dashboard, comma-separated (e.g. one list, or
# "Groceries, Chores"). Only these are ever fetched; every other list stays private.
# Leave empty to show none.
MS_TODO_LISTS=

# Your timezone as an IANA name (e.g. Europe/London). It decides which calendar day a task's
# due date falls on. Leave empty to use this machine's timezone; set it on a server
# (like a NAS) that runs in UTC.
TIMEZONE=

# Delete completed tasks older than this many days from ALL your lists (not only the ones
# above), once a day. Permanent. 0 or empty = off. Preview first with:
#   .venv/bin/python -m app.todos.cleanup --days 30
MS_TODO_CLEANUP_DAYS=
